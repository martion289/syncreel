# All settings below are optional — SyncReel includes a built-in First-Run Setup Wizard
# and automatically generates & persists APP_SECRET under /data/secret.key.

# HTTP port inside container / local dev
PORT=3000

# Public HTTPS origin where SyncReel is reachable (required for Secure cookies, PWA & Chromecast)
# PUBLIC_URL=https://watch.example.com

# Optional: override Plex Media Server URL (otherwise configured via the Setup Wizard)
# PLEX_URL=http://192.168.1.50:32400

# Optional: 64-character hex secret (auto-generated & saved to DATA_DIR/secret.key if omitted)
# APP_SECRET=

# Directory for encrypted state & auto-generated secret persistence (/data inside Docker)
DATA_DIR=./data

# Unique Plex client identifier for this SyncReel instance
CLIENT_IDENTIFIER=syncreel-plex-01

# Optional: Cloudflare API token (Zone -> DNS -> Edit) for the `ddns` profile in docker-compose.yml
# CLOUDFLARE_API_TOKEN=
